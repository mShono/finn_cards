# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to talk to the bot.
# Everyone else gets a polite refusal, no LLM call.
WHITELIST_USER_IDS=

# OpenAI API key and models (used from phase 3 onward - ingest, exercises, voice)
OPENAI_API_KEY=
# Checked against OpenAI's model docs on 25.08.2026 - the lineup moves fast,
# re-check before trusting this blindly in a later phase. Must be a strong
# model, not a nano/mini tier: those don't hold up on Finnish morphology.
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# SQLite database path
DATABASE_URL=sqlite+aiosqlite:///./kielikaveri.db

# Hour (0-23, Europe/Helsinki - not the server's local time, see
# srs/queue.py's STUDY_TIMEZONE) at which a new study day starts for `due`
# card scheduling. Used from phase 2 onward.
DAY_BOUNDARY_HOUR=4
