# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to talk to the bot.
# Everyone else gets a polite refusal, no LLM call.
WHITELIST_USER_IDS=

# OpenAI API key and models (used from phase 3 onward - ingest, exercises, voice)
OPENAI_API_KEY=
# Checked against OpenAI's model docs on 25.08.2026 - the lineup moves fast,
# re-check before trusting this blindly in a later phase. Must be a strong
# model, not a nano/mini tier: those don't hold up on Finnish morphology.
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# Book translator spend cap: OpenAI calls per rolling 24 hours (~15 per
# chapter, so ~10 chapters), and SDK retries per call (the bot keeps 3).
TRANSLATE_DAILY_MAX_CALLS=150
TRANSLATE_MAX_RETRIES=1

# Reader Mini App: public https address behind Caddy, e.g.
# https://203-0-113-7.sslip.io/ - empty keeps the default menu button.
# The bot serves it on READER_HOST:READER_PORT (localhost only).
READER_URL=
READER_PORT=8080

# Reader's own breaker for word lookup and TTS: OpenAI calls per rolling
# window. Separate from the bot's, so reading can't block /add.
READER_BREAKER_MAX_CALLS=150
READER_BREAKER_WINDOW_MINUTES=10

# SQLite database path
DATABASE_URL=sqlite+aiosqlite:///./kielikaveri.db

# Hour (0-23, Europe/Helsinki - not the server's local time, see
# srs/queue.py's STUDY_TIMEZONE) at which a new study day starts for `due`
# card scheduling. Used from phase 2 onward.
DAY_BOUNDARY_HOUR=4

# Logging: level and path to a rotated log file (daily rotation, 14 days
# kept), relative to the working directory. Empty LOG_FILE disables the
# file handler and logs to stdout only.
LOG_LEVEL=INFO
LOG_FILE=logs/kielikaveri.log
