{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kielikaveri.local/cards/schema.json",
  "title": "Kielikaveri card schema",
  "description": "Note + card format. See cards/instructions.md for how to fill it in. Single source of truth for the schema - the bot (phase 1+) imports this file, it does not redefine the format.",
  "$defs": {
    "pos": {
      "type": "string",
      "enum": [
        "substantiivi",
        "verbi",
        "adjektiivi",
        "adverbi",
        "pronomini",
        "numeraali",
        "prepositio",
        "postpositio",
        "konjunktio",
        "interjektio",
        "partikkeli"
      ]
    },
    "cefr": {
      "type": "string",
      "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
    },
    "formsSource": {
      "type": "string",
      "enum": ["fst", "fst+llm", "llm"],
      "description": "fst = every principal form resolved to exactly one FST candidate. fst+llm = at least one form had several FST candidates and an LLM (or a human, in phase 0) must pick one. llm = FST produced nothing for at least one form."
    },
    "cognate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lemma", "pos", "translation_ru"],
      "properties": {
        "lemma": { "type": "string" },
        "pos": { "$ref": "#/$defs/pos" },
        "translation_ru": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["video", "audio", "article", "conversation", "book", "other"]
        },
        "ref": { "type": "string" },
        "context_fi": { "type": "string" }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "lemma", "translation_ru", "example_fi", "example_ru",
        "kind", "meta"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "lemma": {
          "type": "string",
          "description": "Dictionary form for kind=word. The construction itself for kind=pattern, e.g. 'hakea + partitiivi'."
        },
        "pos": { "$ref": "#/$defs/pos" },
        "translation_ru": { "type": "string" },
        "example_fi": { "type": "string" },
        "example_ru": { "type": "string" },
        "kind": { "type": "string", "enum": ["word", "pattern"] },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["forms_source", "forms_verified", "origin"],
          "properties": {
            "word_class_detail": {
              "type": "string",
              "description": "e.g. 'verbityyppi 1'."
            },
            "stems": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "vowel": { "type": ["string", "null"] },
                "consonant": { "type": ["string", "null"] }
              }
            },
            "gradation": { "type": ["string", "null"] },
            "principal_forms": {
              "type": "object",
              "description": "Verb keys: preesens_1s, preesens_3s, imperfekti_3s, nut_partisiippi, passiivi. Noun/adjective keys: nominatiivi, genetiivi, partitiivi, illatiivi, monikon_genetiivi, monikon_partitiivi. All values must come from generate_forms() - never hand-written.",
              "additionalProperties": { "type": "string" }
            },
            "forms_source": { "$ref": "#/$defs/formsSource" },
            "forms_verified": {
              "type": "boolean",
              "description": "false means principal_forms must not be used in inflection exercises (phase 2+)."
            },
            "rektio": { "type": ["string", "null"] },
            "cognates": {
              "type": "array",
              "items": { "$ref": "#/$defs/cognate" }
            },
            "puhekieli": {
              "type": ["string", "null"],
              "description": "Colloquial form. Not FST-validated - puhekieli falls outside literary FST norms."
            },
            "confusable_with": {
              "type": "array",
              "items": { "type": "string" }
            },
            "cefr": { "$ref": "#/$defs/cefr" },
            "topics": {
              "type": "array",
              "items": { "type": "string" }
            },
            "origin": { "type": "string", "enum": ["error", "text"] },
            "source": { "$ref": "#/$defs/source" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "word" } } },
          "then": { "required": ["pos"] }
        }
      ]
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "note_id", "user_id", "type", "srs"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "note_id": { "type": "string", "format": "uuid" },
        "user_id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["recognition", "production", "inflection", "usage"]
        },
        "srs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "due", "stability", "difficulty", "reps", "lapses"],
          "properties": {
            "state": {
              "type": "string",
              "enum": ["learning", "review", "relearning"]
            },
            "due": { "type": "string", "format": "date-time" },
            "stability": { "type": "number", "minimum": 0 },
            "difficulty": { "type": "number", "minimum": 0 },
            "reps": { "type": "integer", "minimum": 0 },
            "lapses": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/note" },
    { "$ref": "#/$defs/card" }
  ]
}
